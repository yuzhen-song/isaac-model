    def "Looks"
    {
        def Material "WhitePLA" (
            customData = {
                dictionary print = {
                    double PLA_solid_density_kg_m3 = 1240
                    double sparse_infill_fraction = 0.15
                }
            }
        )
        {
            token outputs:surface.connect = </World/Looks/WhitePLA/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "ProvisionalContact" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/Looks/ProvisionalContact>
        color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
        double size = 1
