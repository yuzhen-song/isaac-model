        def PhysicsRevoluteJoint "handle_hinge" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
            customData = {
                dictionary friction = {
                    string model = "saturated_viscous_brake"
                    double torqueCapNm = 0.02
                }
            }
        )
        {
            float drive:angular:physics:damping = 1
            float drive:angular:physics:maxForce = 0.02
            float drive:angular:physics:stiffness = 0
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/Espresso/Body>
            rel physics:body1 = </World/Espresso/Handle>
            bool physics:collisionEnabled = 0
            point3f physics:localPos0 = (0.18014313, -0.058, 0.109)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -inf
            float physics:upperLimit = inf
        }
    }

    def DomeLight "Light"
    {
        float inputs:intensity = 600
    }

    def Camera "Camera"
    {
        float2 clippingRange = (0.001, 100)
        float focalLength = 35
        matrix4d xformOp:transform = ( (0.8143654571940346, 0.5803523947819557, 0, 0), (-0.25002354027003615, 0.3508394839273088, 0.9024410705572177, -0), (0.5237338364474731, -0.7349168350150026, 0.4308133170777602, 0), (0.42999999999999994, -0.4999999999999999, 0.34, 0.9999999999999999) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Looks"
    {
        def Material "WhitePLA" (
            customData = {
                dictionary material = {
                    string label = "white PLA"
                }
                dictionary print = {
                    double solidDensityKgM3 = 1260
                }
            }
        )
        {
            token outputs:surface.connect = </World/Looks/WhitePLA/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.9, 0.9)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "ContactPlaceholder" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
            customData = {
                dictionary calibration = {
                    string status = "uncalibrated contact coefficients; independent of hinge brake torque"
                }
            }
        )
        {
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5
        }
    }

    def Cube "Table" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </World/Looks/ContactPlaceholder>
        color3f[] primvars:displayColor = [(0.25, 0.25, 0.25)]
        double size = 1
        float3 xformOp:scale = (1, 1, 0.02)
        double3 xformOp:translate = (0.12, -0.06, -0.011)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

