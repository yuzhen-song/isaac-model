#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" {
    def Xform "Waff" (
        prepend references = @waff.usdc@</Waff>
        delete apiSchemas = ["PhysicsArticulationRootAPI"]
    ) {
        over "WorldFix" (active = false) {}
    }
}
