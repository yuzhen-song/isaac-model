#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" {
    def Xform "Mixer" (
        prepend references = @mixer.usdc@</Mixer>
        delete apiSchemas = ["PhysicsArticulationRootAPI"]
    ) {
        over "WorldFix" (active = false) {}
    }
}
